{
  "manifest_version": 3,
  "name": "TransKit - Power Inline Translate Kit",
  "version": "1.2.2.1",
  "description": "Brings instant, AI-powered translation directly to your input fields. No more switching tabs or copy-pasting\u2014just type translate",
  "author": "@FernNguyen",
  "homepage_url": "https://transkit.app",
  "icons": {
    "16": "assets/icons/icon-16.png",
    "32": "assets/icons/icon-32.png",
    "48": "assets/icons/icon-48.png",
    "128": "assets/icons/icon-128.png"
  },
  "action": {
    "default_popup": "pages/popup.html",
    "default_title": "TransKit",
    "default_icon": {
      "16": "assets/icons/icon-16.png",
      "32": "assets/icons/icon-32.png",
      "48": "assets/icons/icon-48.png",
      "128": "assets/icons/icon-128.png"
    }
  },
  "options_ui": {
    "page": "pages/popup.html",
    "open_in_tab": true
  },
  "background": {
    "scripts": [
      "src/background.js"
    ],
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "src/content-script-granularity.js",
        "src/content-script.js"
      ],
      "css": [
        "assets/styles/inline-suggestion.css",
        "assets/styles/selection.css",
        "assets/styles/hover-translate.css",
        "assets/styles/dialogs.css"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "permissions": [
    "storage",
    "offscreen"
  ],
  "host_permissions": [
    "<all_urls>",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "transkit-addon@void0x14",
      "strict_min_version": "109.0"
    }
  }
}